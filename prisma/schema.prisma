generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @unique
  email           String
  firstName       String
  lastName        String
  profileImageUrl String?
  role            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?
  medicalRecords MedicalRecord[] @relation("DoctorRecords")
  vitalSigns     VitalSign[]     @relation("RecordedBy")
}

model PatientProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  dateOfBirth    DateTime
  gender         String
  phone          String
  address        String
  medicalHistory String?

  user           User            @relation(fields: [userId], references: [id])
  vitalSigns     VitalSign[]
  alerts         Alert[]
  medicalRecords MedicalRecord[]
}

model DoctorProfile {
  id             String @id @default(cuid())
  userId         String @unique
  specialization String
  phone          String
  clinicAddress  String

  user User @relation(fields: [userId], references: [id])
}

model MedicalRecord {
  id             String   @id @default(cuid())
  patientId      String
  doctorId       String
  diagnosis      String
  recommendation String
  createdAt      DateTime @default(now())

  patient PatientProfile @relation(fields: [patientId], references: [id])
  doctor  User           @relation("DoctorRecords", fields: [doctorId], references: [id])
}

model VitalSign {
  id            String   @id @default(cuid())
  patientId     String
  recordedBy    String
  heartRate     Int
  bloodPressure String
  temperature   Float
  recordedAt    DateTime @default(now())

  patient  PatientProfile @relation(fields: [patientId], references: [id])
  recorder User           @relation("RecordedBy", fields: [recordedBy], references: [id])
  alerts   Alert[]
}

model Alert {
  id          String   @id @default(cuid())
  patientId   String
  vitalSignId String
  type        String
  message     String
  seen        Boolean  @default(false)
  createdAt   DateTime @default(now())

  patient   PatientProfile @relation(fields: [patientId], references: [id])
  vitalSign VitalSign      @relation(fields: [vitalSignId], references: [id])
}

